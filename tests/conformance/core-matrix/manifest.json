      "required": true,
      "platforms": ["linux", "darwin", "windows"]
    },
    {
      "id": "lock-bridge-pnpm9",
      "title": "pnpm 9 lock bridge",
      "package": "./tests/conformance",
      "run": "TestLockBridgePnpm9($|PeerContext|AliasPeer)",
      "required": true,
      "requireTools": true,
      "platforms": ["linux", "darwin", "windows"]
    },
    {
      "id": "lock-bridge-pnpm10",
      "title": "pnpm 10 lock bridge",
