      "required": true,
      "platforms": ["linux", "darwin", "windows"]
    },
    {
      "id": "unit-transaction",
      "title": "transaction journal",
      "package": "./internal/transaction",
      "run": "Runner|ScanIncomplete|Journal|Publish",
      "required": true,
      "platforms": ["linux", "darwin", "windows"]
    },
    {
      "id": "integration.cert-negative-zero-match",
      "title": "cert runner zero-match probe",
      "package": "./internal/conformance",
      "run": "^TestCertNegativeDoesNotExist$",
      "required": false,
      "probe": true,
      "platforms": ["linux", "darwin", "windows"]
    },
    {
      "id": "integration.cert-negative-forced-skip",
      "title": "cert runner forced-skip probe",
      "package": "./internal/conformance",
