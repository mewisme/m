      "title": "resolver unit gates",
      "package": "./internal/resolver",
      "run": ".",
      "required": true,
      "platforms": ["linux", "darwin", "windows"]
    },
    {
      "id": "unit-lockfile",
      "title": "lockfile unit gates",
      "package": "./internal/lockfile",
      "run": ".",
      "required": true,
      "platforms": ["linux", "darwin", "windows"]
    },
    {
      "id": "unit-archive-security",
      "title": "archive extraction security",
      "package": "./internal/archive",
      "run": "PatchRejects(Traversal|Absolute|Create|Rename|Duplicate|Symlink)|ExtractRejects(Traversal|Integrity)",
