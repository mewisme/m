{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mewisme/mew/main/schemas/diagnostics/notice.schema.json",
  "title": "Mew notice event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "severity",
    "message"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "notice"
    },
    "severity": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "hint": {
      "type": "string"
    }
  }
}